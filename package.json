{
  "name": "signalk-voice-llm",
  "version": "0.5.0",
  "description": "Answer boat voice commands with a local or remote LLM: subscribes to voice.command (from signalk-wyoming), asks an OpenAI-compatible LLM (LM Studio, Ollama, etc.), and speaks the reply back via say().",
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/test",
    "app-icon.svg",
    "README.md",
    "LICENSE.md",
    "LICENSE-APACHE-2.0-through-v0.4.0.txt"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prettier": "prettier --write .",
    "lint": "eslint --fix",
    "lint:config": "tsc -p tsconfig.tools.json",
    "format": "npm run prettier && npm run lint",
    "ci-lint": "eslint && npm run lint:config && prettier --check .",
    "test": "node --test \"dist/test/**/*.test.js\"",
    "build:all": "npm run ci-lint && npm run build && npm test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-utility",
    "voice",
    "llm",
    "assistant",
    "wyoming",
    "lm-studio",
    "ollama"
  ],
  "signalk": {
    "displayName": "Voice LLM Assistant",
    "appIcon": "./app-icon.svg",
    "requires": [
      "signalk-wyoming"
    ],
    "recommends": [
      "@signalk/open-meteo-provider",
      "signalk-tides",
      "@yachteye/signalk-timezone-plugin"
    ]
  },
  "signalk-plugin-enabled-by-default": false,
  "engines": {
    "node": ">=22"
  },
  "author": "Dirk Wahrheit <dirkwahrheit@gmail.com>",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dirkwa/signalk-voice-llm.git"
  },
  "bugs": {
    "url": "https://github.com/dirkwa/signalk-voice-llm/issues"
  },
  "homepage": "https://github.com/dirkwa/signalk-voice-llm#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "coordinate_to_country": "^1.1.0"
  }
}
